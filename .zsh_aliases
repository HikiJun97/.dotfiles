alias activate='source .venv/bin/activate; prompt pure'
alias pynvim='source $HOME/pynvim/bin/activate'
alias nightly='NVIM_APPNAME=nvim11 bob run nightly'
alias sqlite=sqlite3

gpp (){
	g++ "$1" && ./a.out
}

cd () { builtin cd "$@" && ls; } #execute ls after cd

mkcd (){
	mkdir -p -- "$1" && cd -P -- "$1"
}

uuu() {
  if [[ "$OSTYPE" == "darwin"* ]]; then
    brew update && brew upgrade && brew cleanup
  elif command -v apt &>/dev/null; then
    sudo apt update && sudo apt upgrade -y && sudo apt autoremove -y
  elif command -v dnf &>/dev/null; then
    sudo dnf upgrade -y && sudo dnf autoremove -y
  elif command -v pacman &>/dev/null; then
    sudo pacman -Syu --noconfirm
  else
    echo "uuu: unsupported package manager"
    return 1
  fi
}

nvim() {
  local dir="$PWD"
  local venv=""

  # 현재 디렉토리부터 루트까지 .venv 탐색
  while [[ "$dir" != "/" ]]; do
    if [[ -f "$dir/.venv/bin/activate" ]]; then
      venv="$dir/.venv/bin/activate"
      break
    fi
    dir="$(dirname "$dir")"
  done

  if [[ -n "$venv" ]]; then
    # 가상환경 활성화 후 nvim 실행
    source "$venv"
    command /Users/sgn04088/.local/share/bob/nvim-bin/nvim "$@"
  else
    command /Users/sgn04088/.local/share/bob/nvim-bin/nvim "$@"
  fi
}
#
# fzf로 파일 찾아 nvim으로 열기
fv() {
  local file
  file=$(fzf --preview 'bat --color=always {}' --preview-window=right:60%)
  [[ -n "$file" ]] && nvim "$file"
}
