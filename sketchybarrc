#!/bin/bash

CONFIG_DIR="$HOME/.config/sketchybar"

add_divider() {
    local name=$1
    local pre=${2:-10}
    local post=${3:-10}

    sketchybar --add item "spacer_pre_${name}" right \
        --set "spacer_pre_${name}" \
            width="$pre" \
            icon.drawing=off \
            label.drawing=off

    sketchybar --add item "$name" right \
        --set "$name" \
            width=1 \
            background.color=0x50ffffff \
            background.drawing=on \
            background.height=16 \
            label.drawing=off \
            icon.drawing=off

    sketchybar --add item "spacer_post_${name}" right \
        --set "spacer_post_${name}" \
            width="$post" \
            icon.drawing=off \
            label.drawing=off
}

# ─── Bar appearance ───────────────────────────────────────────────
sketchybar --bar \
    height=34 \
    position=top \
    padding_left=10 \
    padding_right=15 \
    color=0xCC000000 \
    border_width=0 \
    border_color=0x18ffffff \
    shadow=off \
    sticky=on \
    notch_width=200 \
    margin=-1 \
    y_offset=-1

# ─── Global defaults ──────────────────────────────────────────────
sketchybar --default \
    icon.font="SF Pro:Semibold:14.0" \
    icon.color=0x99ffffff \
    label.font="SF Pro:Regular:14.0" \
    label.color=0x99ffffff \
    background.corner_radius=6 \
    background.height=24

# ─── Aerospace workspace event ────────────────────────────────────
sketchybar --add event aerospace_workspace_change

# ─── Left: workspaces ─────────────────────────────────────────────
for sid in $(seq 1 9); do
    sketchybar --add item space.$sid left \
        --subscribe space.$sid aeroasdfspace_workspace_change \
        --set space.$sid \
            icon="$sid" \
            icon.font="SF Pro:Semibold:13.0" \
            icon.color=0x20ffffff \
            label.drawing=off \
            background.drawing=off \
            background.color=0x50ffffff \
            background.corner_radius=6 \
            background.height=24 \
            width=28 \
            align=center \
            click_script="aerospace workspace $sid" \
            script="$CONFIG_DIR/plugins/aerospace.sh $sid"
done

# ─── Left: divider ────────────────────────────────────────────────
sketchybar --add item spacer_pre_divider left \
    --set spacer_pre_divider \
        width=10 \
        icon.drawing=off \
        label.drawing=off

sketchybar --add item divider_left left \
    --set divider_left \
        width=1 \
        background.color=0x50ffffff \
        background.drawing=on \
        background.height=16 \
        label.drawing=off \
        icon.drawing=off

sketchybar --add item spacer_post_divider left \
    --set spacer_post_divider \
        width=18 \
        icon.drawing=off \
        label.drawing=off

# ─── Left: current app name ───────────────────────────────────────
sketchybar --add item app_name left \
    --subscribe app_name front_app_switched \
    --set app_name \
        label.font="SF Pro:Semibold:14.0" \
        label.color=0xddffffff \
        script="$CONFIG_DIR/plugins/app_name.sh"

# ─── Right: CPU ───────────────────────────────────────────────────
sketchybar --add item cpu right \
    --set cpu \
        update_freq=5 \
        icon="" \
        icon.font="SF Pro:Regular:18.0" \
        icon.color=0x60ffffff \
        label.color=0x99ffffff \
        script="$CONFIG_DIR/plugins/cpu.sh"

add_divider divider_4

# ─── Right: Memory ────────────────────────────────────────────────
sketchybar --add item memory right \
    --set memory \
        update_freq=10 \
        icon.font="SF Pro:Regular:18.0" \
        icon.color=0x60ffffff \
        label.color=0x99ffffff \
        script="$CONFIG_DIR/plugins/memory.sh"

add_divider divider_3

# ─── Right: Volume ────────────────────────────────────────────────
sketchybar --add item volume right \
    --subscribe volume volume_change \
    --set volume \
        icon.font="SF Pro:Regular:18.0" \
        icon.color=0x60ffffff \
        icon.padding_right=6 \
        icon.y_offset=1 \
        label.color=0x99ffffff \
        script="$CONFIG_DIR/plugins/volume.sh"

add_divider divider_2

# ─── Right: Battery ───────────────────────────────────────────────
sketchybar --add item battery right \
    --subscribe battery system_woke power_source_change \
    --set battery \
        update_freq=120 \
        icon.font="SF Pro:Regular:18.0" \
        icon.color=0x60ffffff \
        icon.padding_right=6 \
        icon.y_offset=1 \
        label.color=0x99ffffff \
        script="$CONFIG_DIR/plugins/battery.sh"

add_divider divider_1

# ─── Right: Date/Time ─────────────────────────────────────────────
sketchybar --add item datetime right \
    --set datetime \
        update_freq=30 \
        icon.drawing=off \
        label.font="SF Pro:Regular:13.0" \
        label.color=0xddffffff \
        script="$CONFIG_DIR/plugins/datetime.sh"

# ─── Finalize ─────────────────────────────────────────────────────
sketchybar --update
